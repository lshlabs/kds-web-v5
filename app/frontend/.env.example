# Optional frontend runtime/build configuration.
# The app builds without these because defaults/fallbacks exist in code.

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_PORT=5173
BACKEND_PORT=8000

VITE_SITE_URL=http://localhost:5173
VITE_APP_TITLE=KDS Dashboard
VITE_APP_DESCRIPTION=Kitchen display dashboard
VITE_TWITTER_SITE=@atoms
VITE_TWITTER_CREATOR=@atoms

# Fallback values consumed by vite.config.ts when VITE_APP_* is unset.
OVERVIEW_TITLE=KDS Dashboard
OVERVIEW_DESCRIPTION=Kitchen display dashboard
OVERVIEW_LOGO_URL=https://public-frontend-cos.metadl.com/mgx/img/favicon_atoms.ico
